# DashScope / 通义（embedding、重排、主模型）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 可选：DeepSeek 兜底模型
# DEEPSEEK_API_KEY=

# 可选：URL 导入用的 node 路径（不填则用 PATH 里的 node）
# NODE_BIN=

# 日志：INFO / DEBUG / WARNING
LOG_LEVEL=INFO
# 设为 1 时允许 debug 打印完整 Prompt（有泄露风险，默认关闭）
LOG_PROMPT=0
# 可选：JSON 行日志
LOG_JSON=0

# 建号脚本一次性使用，不要写进脚本或提交
# USER_PASSWORD=
