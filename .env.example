# DashScope / 通义（至少一个 Key 即可启动对话）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# FastAPI 受保护接口必填（Bearer 或 X-API-Key）；未配置时 /chat、/rag/summarize 返回 503
# AGENT_API_KEY=change_me_to_a_long_random_string

# 日志：INFO / DEBUG / WARNING
LOG_LEVEL=INFO
# 设为 1 时允许 debug 打印完整 Prompt（有泄露风险，默认关闭）
LOG_PROMPT=0
# 可选：JSON 行日志
LOG_JSON=0

# 可选：网页搜索（未配置则 web_search 降级为未启用）
# TAVILY_API_KEY=
# BOCHA_API_KEY=

# 和风天气（必填 Key + API Host；Host 在控制台「设置」中，形如 xxx.qweatherapi.com，不要带 https://）
# QWEATHER_API_KEY=
# QWEATHER_API_HOST=
